DATABASE_URL="file:./dev.db"

# Mock login credentials are read from env, never hardcoded in source.
MOCK_ADMIN_USERNAME="admin"
MOCK_ADMIN_PASSWORD="admin123"
SESSION_SECRET="replace-with-at-least-32-characters"

# OpenAI is optional for local UI smoke testing. Add a real key for model calls.
OPENAI_API_KEY=""
OPENAI_API_KEYS=""
OPENAI_MODEL="gpt-5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Chroma runs from docker compose on this URL.
CHROMA_URL="http://localhost:8000"
CHROMA_COLLECTION="trainee_knowledge_chunks"

MAX_UPLOAD_MB="10"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"
