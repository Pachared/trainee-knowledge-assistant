DATABASE_URL="file:./dev.db"

# Mock login credentials are read from env, never hardcoded in source.
MOCK_ADMIN_USERNAME="admin"
MOCK_ADMIN_PASSWORD="admin123"
MOCK_ADMIN_USERNAME_FILE=""
MOCK_ADMIN_PASSWORD_FILE=""
SESSION_SECRET="replace-with-at-least-32-characters"
# Production can use *_FILE values from Docker secrets or a secret manager.
SESSION_SECRET_FILE=""

# OpenAI is optional for local UI smoke testing. Add a real key for model calls.
OPENAI_API_KEY=""
OPENAI_API_KEYS=""
OPENAI_API_KEY_FILE=""
OPENAI_API_KEYS_FILE=""
OPENAI_MODEL="gpt-5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Chroma runs from docker compose on this URL.
CHROMA_URL="http://localhost:8000"
CHROMA_COLLECTION="trainee_knowledge_chunks"

MAX_UPLOAD_MB="10"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"
UPLOAD_RATE_LIMIT_WINDOW_MS="60000"
UPLOAD_RATE_LIMIT_MAX="20"
CHAT_RATE_LIMIT_WINDOW_MS="60000"
CHAT_RATE_LIMIT_MAX="60"
MAX_DOCUMENTS_PER_USER="50"
MAX_STORAGE_MB_PER_USER="100"
MAX_DAILY_CHAT_MESSAGES_PER_USER="200"
